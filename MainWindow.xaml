<Window x:Class="AIEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIEditor"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Height="25" VerticalAlignment="Top">
            <MenuItem Header="Настройки" FontSize="15" Click="SettingsClick"/>
        </Menu>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Исходное изображение" FontSize="22" Margin="5" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Изображение стиля" FontSize="22" Margin="5" HorizontalAlignment="Center"/>
        <Image Grid.Row="2" Grid.Column="0" Source="/Images/National_Gallery.jpg" Margin="5"/>
        <Image Grid.Row="2" Grid.Column="1" Source="/Images/Castle.jpg" Margin="5"/>
        <Button Grid.Row="3" Grid.Column="0" Content="Загрузить изображение" Margin="5" FontSize="22" MaxHeight="75" MaxWidth="250"/>
        <Button Grid.Row="3" Grid.Column="1" Content="Загрузить изображение" Margin="5" FontSize="22" MaxHeight="75" MaxWidth="250"/>
        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="Обработать" Margin="5" FontSize="22" MaxHeight="75" MaxWidth="250"/>
    </Grid>
</Window>
