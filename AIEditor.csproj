<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\Castle.jpg" />
    <None Remove="Images\icon.png" />
    <None Remove="Images\National_Gallery.jpg" />
    <None Remove="Images\no_image.jpg" />
    <None Remove="Images\no_image2.jpg" />
    <None Remove="Images\result.PNG" />
    <None Remove="Images\vangog.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\Castle.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\National_Gallery.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\no_image.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\vangog.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="libtorch-cpu-win-x64" Version="2.5.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="TorchSharp" Version="0.105.1" />
    <PackageReference Include="TorchVision" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Weights\" />
  </ItemGroup>

</Project>
