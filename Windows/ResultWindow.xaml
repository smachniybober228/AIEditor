<Window x:Class="AIEditor.Windows.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIEditor.Windows"
        mc:Ignorable="d"
        Title="Результат" MinHeight="345" MinWidth="270" Height="525" Width="470" Background="#0a0a0f"
        Icon="/Images/icon.png">
    <Window.Resources>
        <Style x:Key="BorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#00ff9d"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#010133"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="MaxHeight" Value="75"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="BorderBrush" Value="#ff00ff"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Background" Value="#010133"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource BorderStyle}" Grid.Row="0">
            <Image Name="ResultImage" Margin="5"/>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Сохранить" Click="SaveImage"/>
            <Button Grid.Column="1" Content="Вернуться" Click="BackToMainWindow"/>
        </Grid>
    </Grid>
</Window>
