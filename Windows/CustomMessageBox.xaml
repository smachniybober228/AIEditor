<Window x:Class="AIEditor.Windows.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" 
        Height="225" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent">
    <Window.Icon>
        <DrawingImage/>
    </Window.Icon>
    <Window.Resources>
        <Style x:Key="FuturisticButton" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MaxHeight" Value="75"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="BorderBrush" Value="#ff00ff"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#010133"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
        </Style>
    </Window.Resources>

    <Border Background="#010133"
            BorderBrush="#00ff9d"
            BorderThickness="2"
            CornerRadius="12">

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="0,0,0,15"
                       x:Name="TitleText"
                       Text="Сообщение"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#00ff9d"
                       VerticalAlignment="Center"/>
            
            <!-- Текст сообщения -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,15">
                <TextBlock x:Name="MessageText"
                           Text="Текст сообщения"
                           Foreground="#e0e0e0"
                           FontSize="14"
                           TextWrapping="Wrap"/>
            </ScrollViewer>


            <Button Grid.Row="2"
                    HorizontalAlignment="Right"
                    x:Name="Button1"
                    Content="OK"
                    Style="{StaticResource FuturisticButton}"
                    Width="80"
                    Margin="0,0,10,0"
                    Click="Button1_Click"/>
                
        </Grid>
    </Border>
</Window>