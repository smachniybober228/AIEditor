<Window x:Class="AIEditor.Windows.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обработка изображений" 
        Height="150" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Icon="/Images/icon.png">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Background="#010133">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Идет обработка изображений..." 
                   Margin="20,20,20,10"
                   HorizontalAlignment="Center"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#00ff9d"/>

        <!-- ProgressBar -->
        <ProgressBar Grid.Row="1" 
                     Name="ProgressBarControl"
                     Height="20" 
                     Margin="20,0,20,10"
                     Minimum="0" 
                     Maximum="100"
                     Foreground="#00ff9d"
                     Background="#2a2a4e">
            <ProgressBar.Effect>
                <DropShadowEffect BlurRadius="10" 
                                  Color="#00ff9d" 
                                  Opacity="0.3"/>
            </ProgressBar.Effect>
        </ProgressBar>

        <!-- Текст прогресса -->
        <TextBlock Grid.Row="2" 
                   Name="ProgressText"
                   Text="Подготовка..." 
                   Margin="20,0,20,20"
                   HorizontalAlignment="Center"
                   Foreground="#8888a0"/>
    </Grid>
</Window>